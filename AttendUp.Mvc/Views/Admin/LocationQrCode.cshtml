@model AttendUp.Mvc.ViewModels.LocationQrCodeViewModel

@{
    ViewBag.Title = "QR-code exporteren";
}

<div class="main training-create-page">
    <div class="training-modal">
        <div class="training-modal__header">
            <h2 class="training-modal__title">QR-code - @Model.LocationName</h2>
            <button type="button" class="training-modal__close" onclick="window.location.href='/Admin/Location';">&times;</button>
        </div>

        <div style="display:flex; flex-direction:column; align-items:center; gap:12px; padding: 16px 0;">
            <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR-code @Model.LocationName" style="width:200px; height:200px;" />
        </div>

        <div class="training-modal__actions">
            <a href="/Registration?locationId=@Model.LocationId" class="btn btn-outline">Ga naar registratie</a>
            <a href="/Admin/Location/QrCodeDownload/@Model.LocationId?format=png" class="btn btn-outline">&#11015; PNG</a>
            <a href="/Admin/Location/QrCodeDownload/@Model.LocationId?format=pdf" class="btn btn-primary">&#11015; PDF</a>
        </div>
    </div>
</div>
