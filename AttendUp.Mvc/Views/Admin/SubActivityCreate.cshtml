@model AttendUp.Mvc.Models.SubActivity

@{
    ViewBag.Title = "Aanmaken subactiviteit";
}

<div class="main training-create-page">
    <form class="training-modal" method="post" asp-controller="SubActivity" asp-action="SubActivityCreate">
        <div class="training-modal__header">
            <h2 class="training-modal__title">Nieuwe subactiviteit</h2>
            <button type="button" class="training-modal__close" onclick="window.location.href='/Admin/SubActivity';">&times;</button>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-top: 16px;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p style="margin:0">@error.ErrorMessage</p>
                }
            </div>
        }

        <div class="field">
            <label>Naam</label>
            <input type="text" class="input no-icon" asp-for="Name" placeholder="Naam subactiviteit" required />
        </div>

        <div class="training-modal__actions">
            <button type="button" class="btn btn-outline" onclick="window.location.href='/Admin/SubActivity';">Annuleer</button>
            <button type="submit" class="btn btn-primary">Aanmaken</button>
        </div>
    </form>
</div>