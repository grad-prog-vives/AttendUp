@model AttendUp.Mvc.ViewModels.SeasonPlanningViewModel
@{
    ViewBag.Title = "Jaarplanning aanmaken";
}

<div class="main training-create-page">
    <form class="training-modal" method="post" asp-action="SeasonPlanning" asp-controller="Training">

        <div class="training-modal__header">
            <h2 class="training-modal__title">Jaarplanning aanmaken</h2>
            <button type="button" class="training-modal__close" aria-label="Sluiten"
                    onclick="window.location.href='/Admin/Training';">&times;</button>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="field">
            <label>Titel</label>
            <input type="text" class="input" asp-for="Title" placeholder="bv. Training" required />
        </div>

        <div class="field">
            <label>Startdatum seizoen</label>
            <input type="date" class="input" asp-for="StartDate" required />
        </div>

        <div class="field">
            <label>Einddatum seizoen</label>
            <input type="date" class="input" asp-for="EndDate" required />
        </div>

        <div class="field">
            <label>Dagen van de week</label>
            <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:6px;">
                @foreach (var day in new[] {
                    (DayOfWeek.Monday, "Maandag"),
                    (DayOfWeek.Tuesday, "Dinsdag"),
                    (DayOfWeek.Wednesday, "Woensdag"),
                    (DayOfWeek.Thursday, "Donderdag"),
                    (DayOfWeek.Friday, "Vrijdag"),
                    (DayOfWeek.Saturday, "Zaterdag"),
                    (DayOfWeek.Sunday, "Zondag")
                })
                {
                    <div style="display:flex; align-items:center; gap:6px;">
                        <input type="checkbox" name="SelectedDays" value="@((int)day.Item1)" id="day_@day.Item1" />
                        <label for="day_@day.Item1" style="font-weight:normal;">@day.Item2</label>
                    </div>
                }
            </div>
            <span asp-validation-for="SelectedDays" class="text-danger small d-block mt-1"></span>
        </div>

        <div class="field">
            <label>Startuur</label>
            <input type="time" class="input" asp-for="StartTime" required />
        </div>

        <div class="field">
            <label>Einduur</label>
            <input type="time" class="input" asp-for="EndTime" required />
        </div>

        <div class="field">
            <label>Subactiviteiten</label>
            @foreach (var s in Model.AllSubActivities)
            {
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                    <input type="checkbox" name="SelectedSubActivityIDs" value="@s.ID" id="sub_@s.ID" checked />
                    <label for="sub_@s.ID" style="font-weight:normal;">@s.Name</label>
                </div>
            }
            <span asp-validation-for="SelectedSubActivityIDs" class="text-danger small d-block mt-1"></span>
        </div>

        <div class="training-modal__actions">
            <button type="button" class="btn btn-outline"
                    onclick="window.location.href='/Admin/Training';">Annuleer</button>
            <button type="submit" class="btn btn-primary">Aanmaken</button>
        </div>

    </form>
</div>
