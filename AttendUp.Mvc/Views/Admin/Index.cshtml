@model AttendUp.Mvc.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}
<main class="main">

    @if(Model.HasSeedingData)
    {   
        <h1>Dashboardoverzicht</h1>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-head">
                    <span>Vandaag aanwezig</span>
                    <span class="ico">&#128101;</span>
                </div>
                <p class="stat-value">@Model.TodayAttendance leden</p>
                <p class="stat-trend">&#8599; @Model.TodayPercentChange % vs vorige week</p>
            </div>
            <div class="stat-card">
                <div class="stat-head">
                    <span>Weekgemiddelde per training</span>
                    <span class="ico">&#127947;</span>
                </div>
                <p class="stat-value">@Model.AveragePerTraining leden</p>
                <p class="stat-trend">&#8599; @Model.AveragePercentChange % stijging</p>
            </div>
            <div class="stat-card">
                <div class="stat-head">
                    <span>Actieve trainingen</span>
                    <span class="ico">&#9201;</span>
                </div>
                <p class="stat-value">@Model.ActiveTrainingsThisWeek actief</p>
                <p class="stat-trend" style="color: var(--muted)">deze week</p>
            </div>
        </div>

        <section class="table-card">
            <div class="table-head">
                <h3>Top 10 Meest Actieve Leden</h3>
                <a asp-controller="Admin" asp-action="ViewAllMembers" class="btn btn-primary btn-sm">Toon alle leden</a>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Naam lid</th>
                        <th>Trainingssessies</th>
                        <th>Activiteitsniveau</th>
                        <th>Laatst actief</th>
                        <th>Acties</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.TopMembers)
                    {
                        <tr>
                            @{
                                var FirstName = char.ToUpper(m.FirstName[0]);
                                var LastName = char.ToUpper(m.LastName[0]);
                            }
                            <td><div class="member"><span class="avatar">@FirstName@LastName</span> @m.FirstName @m.LastName</div></td>
                            <td>@m.RegistrationCount sessies</td>
                            <td><span class="badge badge-high">Hoog</span></td>
                            <td>

                                @{
                                    var date = m.LastActive.Date;
                                    var today = DateTime.Today;

                                    string formatted;

                                    if (date == today)
                                    {
                                        formatted = $"Vandaag, {m.LastActive:hh:mm tt}";
                                    }
                                    else if (date == today.AddDays(-1))
                                    {
                                        formatted = $"Gisteren, {m.LastActive:hh:mm tt}";
                                    }
                                    else
                                    {
                                        formatted = m.LastActive.ToString("MMM dd, hh:mm tt");
                                    }
                                    formatted = char.ToUpper(formatted[0]) + formatted.Substring(1);
                                }

                                    @formatted
                            </td>
                            <td><button class="action-btn">&#8942;</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
    else
    {
        <p>Nog geen data aanwezig. Voeg hier data toe: </p>
    }
</main>