@model AttendUp.Mvc.ViewModels.ResetPasswordViewModel
@{
    Layout = "_Layout";
}
@{
    var b = ViewBag.Branding as AttendUp.Mvc.Models.Setting;
}
<style>
    :root {
        --orange: @(b?.ButtonColor ?? "#F58220");
        --bg: @(b?.BackgroundColor ?? "#F5F5F5");
        --orange-dark: @(b?.ButtonColor ?? "#F58220");
    }
</style>

<div class="container px-4 my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">

            <form asp-action="ResetPassword" method="post" class="login-card">

                @* Ik gebruik deze validatie-samenvatting om fouten vanuit de database (zoals een te kort wachtwoord) in het rood te tonen. *@
                @* AANPASSING: De alert-klassen tonen pas als de modelstate daadwerkelijk ongeldig is, om een lege rode balk te voorkomen. *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger fw-bold mb-3" role="alert"></div>
                }

                <h2 class="mb-4 text-center text-md-start">Wachtwoord herstellen</h2>
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                <div class="field">
                    <label asp-for="Password" class="form-label fw-bold">Nieuw Wachtwoord</label>
                    @* Ik gebruik asp-for zodat dit invoerveld direct gekoppeld is aan de validatieregels van het model. *@
                    <input asp-for="Password" class="input no-icon" type="password" autocomplete="new-password" required />
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold">Bevestig Nieuw Wachtwoord</label>
                    @* Ik gebruik ook hier asp-for om ervoor te zorgen dat de browser direct controleert of beide wachtwoorden gelijk zijn. *@
                    <input asp-for="ConfirmPassword" class="input no-icon" type="password" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Wachtwoord opslaan</button>
                </div>
            </form>

        </div>
    </div>
</div>

@* Ik voeg de scripts toe zodat de client-side validatie direct in de browser van de bezoeker draait. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}