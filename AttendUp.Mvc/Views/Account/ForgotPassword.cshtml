@model AttendUp.Mvc.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_Layout";
}
@{
    var b = ViewBag.Branding as AttendUp.Mvc.Models.Setting;
}
<style>
    :root {
        --orange: @(b?.ButtonColor ?? "#F58220");
        --bg: @(b?.BackgroundColor ?? "#F5F5F5");
        --orange-dark: @(b?.ButtonColor ?? "#F58220");
    }
</style>

<div class="container fluid px-3 my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <form method="post" asp-action="ForgotPassword" class="login-card">
                @* Validatie-samenvatting bovenaan - Toont alleen als er echt fouten zijn *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger fw-bold mb-3" role="alert"></div>
                }

            <h2 class="text-center mb-3">Wachtwoord vergeten</h2>
            <p class="text-center text-muted mb-4">Vul je e-mailadres in om een reset-link te ontvangen.</p>

                <div class="field">
                    <label asp-for="Email" class="form-label fw-bold">Emailadres</label>
                    @* type="email" zorgt voor het @-teken op het mobiele toetsenbord.
                       autocomplete, autocapitalize en autocorrect voorkomen dat de telefoon rare correcties uitvoert op het mailadres. *@
                    <input asp-for="Email" type="email" class="input no-icon" placeholder="naam@voorbeeld.nl" autocomplete="email" autocapitalize="none" autocorrect="off" required />
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>
                
                @* w-100 en py-3 zorgen voor een grote, makkelijk in te drukken knop op mobiel *@
                <button type="submit" class="btn btn-primary">Verstuur reset-link</button>
            </form>

            @* Test-knop sectie *@
            @* Ik toon deze card alleen als er in de controller een test-link (GegenereerdeLink) is aangemaakt, zodat we tijdens het ontwikkelen makkelijk kunnen doorklikken. *@
            @if (ViewBag.GegenereerdeLink != null)
            {
                <div class="card login-card mt-4 p-3 border-primary shadow-sm">
                    @* Hier staat de cijfercode (&#128274;) nu netjes voor de tekst voor een universeel gouden slotje *@
                    <h2 class="h4 text-center mb-1">
                        &#128274; Wachtwoord Reset
                    </h2>
                    <div class="login-subtitle text-center small text-muted mb-3">RESET UW WACHTWOORD</div>
                    
                    <p class="text-center small mb-3">Klik op de onderstaande knop om de reset-pagina te openen.</p>
                    
                    <a href="@ViewBag.GegenereerdeLink" class="btn btn-outline-primary" target="_blank">
                        Open reset-pagina
                    </a>
                </div>
            }

            @* Confirm sectie
            Melding tonen dat er een email is verzonden *@
            @if (ViewBag.Confirm != null)
            {
                <div class="card login-card mt-4 p-3 border-primary shadow-sm">
                    <h2 class="h4 text-center mb-1">
                        &#128274; Bevestigd
                    </h2>
                    <div class="login-subtitle text-center small text-muted mb-3">@ViewBag.Confirm</div>
                </div>
            }

            @* Foutmelding sectie *@
            @* Als de user niet bestaat of de database een fout geeft, vang ik die hier op in een duidelijke rode kaart met een opvallende linker-border. *@
            @if (ViewBag.Foutmelding != null)
            {
                <div class="card login-card mt-4 p-3 border-danger shadow-sm text-center" style="border-left: 5px solid #dc3545 !important;">
                    <h2 class="h4 text-danger mb-1">Foutmelding</h2>
                    <div class="login-subtitle small text-danger fw-bold mb-3">USER BESTAAT NIET</div>
                    
                    <p class="mb-0 small text-muted">
                        @ViewBag.Foutmelding
                    </p>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @* Dit zorgt ervoor dat jQuery validatie direct in de browser van de gebruiker (client-side) checkt of de invoer klopt. *@
    <partial name="_ValidationScriptsPartial" />
}