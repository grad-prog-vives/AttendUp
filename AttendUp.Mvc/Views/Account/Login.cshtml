@model AttendUp.Mvc.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
}
@{
    var b = ViewBag.Branding as AttendUp.Mvc.Models.Setting;
}
<style>
    :root {
        --orange: @(b?.ButtonColor ?? "#F58220");
        --bg: @(b?.BackgroundColor ?? "#F5F5F5");
        --orange-dark: @(b?.ButtonColor ?? "#F58220");
    }
</style>
<div class="container px-4 my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">

            <form asp-action="Login" method="post" class="login-card">
                @* Ik heb dit validatie-overzicht toegevoegd zodat algemene foutmeldingen (zoals 'Ongeldige loginpoging') nu écht op het scherm getoond worden in plaats van dat er geruisloos niets gebeurt. *@
                <h2 class="mb-4 text-center text-md-start">Inloggen</h2>
                <p class="lead">Vul je gegevens in.</p>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="field">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    @* Ik heb name="email" vervangen door asp-for="Email". Hierdoor zorg ik ervoor dat de invoer met een hoofdletter 'E' naar de controller wordt gestuurd, zodat het exact matcht met jouw LoginViewModel. *@
                    <input asp-for="Email" class="input no-icon" type="email" autocomplete="email" autocapitalize="none" autocorrect="off" required />
                    @* Ik heb deze span toegevoegd om specifieke fouten over het mailadres (zoals een missend @-teken) te tonen. *@
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="field">
                    <label asp-for="Password" class="form-label fw-bold">Wachtwoord</label>
                    @* Ik heb ook hier name="password" vervangen door asp-for="Password". Hiermee heb ik de hoofdlettergevoeligheid-fout opgelost waardoor het wachtwoord voorheen niet aankwam in de controller. *@
                    <input asp-for="Password" class="input no-icon" type="password" autocomplete="current-password" required />
                    @* Ik heb deze span toegevoegd zodat de gebruiker ziet wanneer het wachtwoordveld leeg is gelaten. *@
                    <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label">Onthoud mij</label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Inloggen</button>
                    <a asp-action="ForgotPassword" class="btn btn-link text-center mt-2 py-2">Wachtwoord vergeten?</a>
                    <a asp-action="Register" class="btn btn-link text-center py-2">Nog geen account? Registreer hier</a>
                </div>
            </form>

        </div>
    </div>
</div>