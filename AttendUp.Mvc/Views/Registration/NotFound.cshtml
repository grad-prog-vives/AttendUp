@model AttendUp.Mvc.ViewModels.NotFoundViewModel
@{
    ViewData["Title"] = "Geen training";
    var b = ViewBag.Branding as AttendUp.Mvc.Models.Setting;
}
<style>
    :root {
        --orange: @(b?.ButtonColor ?? "#F58220");
        --bg: @(b?.BackgroundColor ?? "#F5F5F5");
    }
</style>

<div class="login-page">
    <div class="login-wrap">

        <div class="login-logo-wrap">
            <img src="@(ViewBag.Branding is AttendUp.Mvc.Models.Setting b2 && b2.LogoPath != null ? b2.LogoPath : "/images/logo.png")" alt="AttendUp logo" class="login-logo-img" />
        </div>

        <div class="login-card" style="text-align:center;">
            <div class="success-icon" style="background: var(--yellow-bg);">
                <span style="color: var(--yellow); font-size: 30px;">&#9888;</span>
            </div>
            @if (Model != null && Model.TodayTrainingDeactivated)
            {
                <h2 class="success-title">Training geannuleerd</h2>
                <p class="success-text">@Model.DeactivationReason</p>
            }
            else
            {
                <h2 class="success-title">Vandaag geen training gepland</h2>
                <p class="success-text">Je kan lekker chillen.</p>
            }
        </div>

        <partial name="_NextTraining" model="Model" />

        @if (b != null && !string.IsNullOrEmpty(b.EventBannerPath))
        {
            <div class="event-banner-wrap">
                <img src="@b.EventBannerPath?v=@DateTime.Now.Ticks" alt="Event banner" class="event-banner-img" />
            </div>
        }

    </div>
</div>
